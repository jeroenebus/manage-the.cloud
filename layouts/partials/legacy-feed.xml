{{ `<?xml version="1.0" encoding="utf-8"?>` | safeHTML }}
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom" xmlns:content="http://purl.org/rss/1.0/modules/content/">
  <channel>
    <title>{{ site.Title }}</title>
    <link>{{ site.Home.Permalink }}</link>
    <description>{{ site.Params.description | default site.Title }}</description>
    <language>en</language>
    <lastBuildDate>{{ now.Format "Mon, 02 Jan 2006 15:04:05 -0700" }}</lastBuildDate>
    <atom:link href="{{ "feed/" | absURL }}" rel="self" type="application/rss+xml"/>
    {{- range first 20 (where site.RegularPages "Section" "posts").ByDate.Reverse }}
    <item>
      <title>{{ .Title }}</title>
      <link>{{ .Permalink }}</link>
      <pubDate>{{ .Date.Format "Mon, 02 Jan 2006 15:04:05 -0700" }}</pubDate>
      <guid isPermaLink="false">{{ with .Params.wpid }}{{ printf "https://manage-the.cloud/?p=%v" . }}{{ else }}{{ $.Permalink }}{{ end }}</guid>
      <description>{{ (.Description | default .Summary) | plainify | transform.XMLEscape | safeHTML }}</description>
      <content:encoded>{{ replaceRE `(src|href)="/([^/])` (printf `$1="%s$2` site.Home.Permalink) .Content | transform.XMLEscape | safeHTML }}</content:encoded>
    </item>
    {{- end }}
  </channel>
</rss>
